# Token bí mật xác thực đường hầm Cloudflare Tunnel (Lấy từ Cloudflare Zero Trust Dashboard)
CLOUDFLARE_TUNNEL_TOKEN=eyJhIjoiY2xvdWRmbGFyZS10b2tlbi1leGFtcGxl...

# Định danh ID của Cloudflare Tunnel
CLOUDFLARE_TUNNEL_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Địa chỉ IP của Private HPC Compute Node (qua Tailscale Mesh VPN hoặc Local IP)
HPC_NODE_HOST=100.85.120.45
HPC_NODE_PORT=8000

# Cổng lắng nghe của Nginx Gateway
GATEWAY_HTTP_PORT=80

# Mức độ chi tiết log: 'warn' | 'error' | 'info'
NGINX_LOG_LEVEL=warn
